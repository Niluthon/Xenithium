# Writes OUT, a C++ source whose xenithium::build_rev() returns `git describe --always --dirty` of SRC, else REV when
# given (-DXENITHIUM_BUILD_REV=..., e.g. a Docker build, whose context has no .git), else "unknown" (no checkout, no git,
# or git refusing the folder: safe.directory). Run at every build (tools/CMakeLists.txt: xenithium-build-rev); the file is rewritten only
# when the revision changes, so an unchanged tree recompiles nothing. The server reports it in GET /v1/models.
execute_process(COMMAND git describe --always --dirty
                WORKING_DIRECTORY ${SRC}
                OUTPUT_VARIABLE rev
                OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET
                RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR rev STREQUAL "")
  set(rev "${REV}")
endif()
string(REGEX REPLACE "[^A-Za-z0-9._+-]" "" rev "${rev}")  # a revision, nothing that could break the C++ string
if(rev STREQUAL "")
  set(rev "unknown")
endif()
set(text "// Generated by cmake/BuildRev.cmake at build time; do not edit.\nnamespace xenithium {\nconst char *build_rev() { return \"${rev}\"; }\n}  // namespace xenithium\n")
set(old "")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
  file(WRITE ${OUT} "${text}")
endif()
