# qwen38-w4a16-intel on four cards (XEN_Q38_TP=4): this setup's settings over qwen38-w4a16-intel.env, the fastest we
# measured (docs/recommended-settings-qwen38-flash-next.md). 16 slots, a 1,048,576-token max context (YaRN per request)
# on an int8 KV cache split by tokens, the DFlash 2 drafter, prefill chunks of 4,096 tokens, decode steps of up to 64
# rows (the four-card default). Every expert fits in VRAM, so the CPU expert path is off.
XEN_SLOTS=16
XEN_CONTEXT=1048576
XEN_KV_SPLIT=tokens
XEN_DRAFTER_MODEL=~/models/qwen38-flash-next-dflash2
XEN_PREFILL_CHUNK=4096
XEN_PREFIX_MARK_MIN=2048
XEN_PREFIX_CACHE_GIB=24
XEN_SAMPLE_THREADS=8
XEN_MOE_CPU=off
